page {
  background-color: #E5E5E5;
}

.container{
	width: 100%;
	height: 100%;
	display: flex;
	flex-direction: column;
	background-color: #e5e5e5;
  overflow-x: hidden;
  overflow-y: hidden;
}

.tabContainer{
  width: 95%;
  height: 100vh;
  margin: auto;
}

.tab{
  width: 100%;
  height: 18vh;
  border-radius: 5px;
  margin-top: 1vh;
  display: flex;
  flex-direction: row;
  background-color: #ffffff;
}

.tab_left{
  width: 78px;
  height: 18vh;
  display: flex;
  align-items: center;
}


.tab_left_icon{
  width: 64px;
  height: 64px;
  margin-left: 14px;
  border-radius: 20px;
  opacity: 1;
}

.tab_right{
  width: calc(100% - 25px);
  height: 18vh;
  margin-left:25px;
}

.serviceCaseNumber{
  margin-top: 2vh;
}

.neoNumber{
  margin-top: 0.5vh;
}

.evaluate{
  width: 70vw;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}


